# Copier en .env et remplir
# Le fichier .env est ignore par git pour ne pas exposer les secrets

# --- Alerte mail (optionnel) ---
ALERT_BACKEND=webhook            # smtp | webhook

# Pour SMTP (Gmail recommande mot de passe application) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Pour webhook (Discord/Slack/Teams) :
WEBHOOK_URL=

# --- Rapport quotidien ---
REPORT_TO=

# --- Override eventuels ---
# POLL_INTERVAL=12
# BATCH_SIZE=5
# SCORE_THRESHOLD=0.5
